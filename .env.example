# =========================================================================
# Ops Insight Assistant - 本地環境變數設定檔範本 (.env.example)
# =========================================================================
# 說明：
# 1. 複製此檔案為 .env：
#    Windows: copy .env.example .env
#    Linux:   cp .env.example .env
# 2. 填入您的真實金鑰與連線字串
# 3. .env 檔案已被 .gitignore 忽略，不會被 commit 到版本控制中
# =========================================================================

# -------------------------------------------------------------------------
# 1. AI 模型金鑰 (LLM API Keys)
# -------------------------------------------------------------------------
# Google Gemini API 金鑰 (若 ai.provider 為 "gemini")
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# 公司私有 LLM 平台 / OpenAI / Azure / Ollama 金鑰 (若 ai.provider 為 "openai_compatible")
CORP_LLM_KEY=your_internal_llm_token_here

# 自訂 HTTP API Token (若 ai.provider 為 "custom_http")
CORP_API_TOKEN=your_custom_api_token_here

# -------------------------------------------------------------------------
# 2. 資料庫連線字串 (Database Connection String)
# -------------------------------------------------------------------------
# 當 data_source.type 為 "database" 時使用
# 範例 (SQL Server): mssql+pyodbc://user:password@server/dbname?driver=ODBC+Driver+17+for+SQL+Server
# 範例 (PostgreSQL): postgresql+psycopg2://user:password@server/dbname
# 範例 (Oracle):     oracle+cx_oracle://user:password@server:1521/?service_name=orcl
DB_CONNECTION_STRING=mssql+pyodbc://user:password@server/dbname?driver=ODBC+Driver+17+for+SQL+Server

# -------------------------------------------------------------------------
# 3. Email 發信帳號密碼 (SMTP Authentication)
# -------------------------------------------------------------------------
# 當 notifications.email.enabled 為 true 時使用
SMTP_USER=ops-assistant@company.com
SMTP_PASSWORD=your_smtp_auth_password_here

# -------------------------------------------------------------------------
# 4. Microsoft Teams Webhook URL (可選，亦可直接寫在 config.yaml)
# -------------------------------------------------------------------------
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your-webhook-token
